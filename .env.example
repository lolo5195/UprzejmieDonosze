# Copy this file to .env and fill in your own values. Never commit .env.
# Spring Boot reads it via spring.config.import (see application.properties).
# Format: KEY=value, no quotes. Real environment variables take precedence.

# Oracle database
DB_URL=jdbc:oracle:thin:@//localhost:1521/XEPDB1
DB_USERNAME=UPRZEJMIE
DB_PASSWORD=change-me

# Admin account created on first start (only if no admin exists yet)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
